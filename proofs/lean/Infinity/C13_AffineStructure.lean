import Mathlib.Data.ZMod.Basic
import Mathlib.Algebra.Polynomial.AlgebraMap
import Mathlib.Data.Nat.Factorization.Basic
import Mathlib.RingTheory.Polynomial.GaussLemma
import Mathlib.RingTheory.Localization.Integral
import Mathlib.Analysis.Polynomial.Basic
import Mathlib.Tactic

/-!
# Cycle C13 — The structure of affine spectra (CLM-C13-01, Theorem 1 (a)–(f))

Written proof: `proofs/paper/C13.md`, Theorem 1.  Polynomials are integer polynomials `ℤ[X]`, evaluated
at `a : ZMod N` with `Polynomial.aeval a f` (`ZMod N` is a `ℤ`-algebra).

* `affine_anchored` (CLM-C13-01 (a)): an anchored operation of the form `x ⋆ y = α x + β y + γ` on
  `ZMod N` has `α = 1` and `γ = 1`, so it is `x ⋆ y = x + β y + 1`; `affine_table_anchored` is the
  converse. Both hold for every `N` (for `N = 1` trivially).
* `Aff S` : for a set `S ⊆ ℤ[X]`, `Aff S = {N ≥ 1 : the polynomials of S have a common root mod N}`.
* `Term.eval_affine`, `law_holds_affine_iff`, `affModels_eq` (CLM-C13-01 (b)): for terms over a finite
  set of variables, every term evaluates in the affine table `x ⋆ y = x + a·y + 1` to the linear form
  `Σ_v C_t[v](a)·v + D_t(a)`; a law `s = t` holds in that table iff every polynomial of its affine
  system `Sys(s = t) = {C_s[v] - C_t[v]} ∪ {D_s - D_t}` vanishes at `a`; hence the set `affModels E` of
  sizes `N ≥ 1` with an affine anchored model of the laws `E` equals `Aff (sysLaws E)`.
* `aff_one`, `aff_of_dvd`, `aff_mul_of_coprime` (CLM-C13-01 (c)): `1 ∈ Aff S`, `Aff S` is closed under
  divisors and under products of coprime elements (Chinese remainder theorem, `ZMod.chineseRemainder`).
* `mem_aff_iff_primePow` ((c), "hence"): for `N ≠ 0`, `N ∈ Aff S ↔ p ^ v_p(N) ∈ Aff S` for every
  prime `p ∣ N`.
* `aff_structure_of_no_common_factor` (CLM-C13-01 (d)): if the polynomials of a finite `S` have no
  common factor of positive degree in `ℚ[X]`, then `Aff S` is finite, equals the set of divisors of its
  maximum `L`, and `L` divides every integer in the ideal generated by `S` in `ℤ[X]`. Ingredients:
  `exists_int_mem_ideal` (Bézout in the PID `ℚ[X]` and clearing denominators), `dvd_of_mem_aff`,
  `aff_finite`, `aff_lcm`, `aff_eq_divisors` (any finite `Aff S` is the set of divisors of its
  maximum), `aff_eq_divisors_of_ideal`.
* `aff_infinite`, `aff_infinite_of_dvd`, `aff_empty` (CLM-C13-01 (e)): a common factor of positive degree
  in `ℚ[X]` makes `Aff S` infinite; `Aff ∅ = {N ≥ 1}`. The proof differs from the paper's (which uses
  Gauss's lemma and Schur's theorem to get infinitely many *primes*): after Gauss's lemma it uses that
  `|G(k)|` is unbounded and `k` is a root of `G` modulo `|G(k)|`; this gives infinitely many `N`, which is
  what (e) claims.
* `aff_of_root` ((f), first sentence): if `G ∣ f` for every `f ∈ S`, every `N ≥ 1` modulo which `G` has
  a root lies in `Aff S`.
* `primePow_root_iff`, `primePow_mem_aff_iff`, `primePow_root_iff_of_mem_span` ((f)): if `f = G * h f`
  for all `f ∈ S`, `Σ_{f ∈ S} u f * h f = C R'` (more generally `C R' ∈ Ideal.span (h '' S)`) and `p` is a
  prime with `p ∤ R'`, then for every `e`:
  `(∃ a : ZMod (p ^ e), ∀ f ∈ S, f(a) = 0) ↔ ∃ a : ZMod (p ^ e), G(a) = 0`.
* `primePow_mem_aff_iff_of_coprime_cofactors` ((f), complete): if moreover the cofactors `h f` have no
  common factor of positive degree in `ℚ[X]`, such an `R' ≠ 0` exists (via `exists_int_mem_ideal`), and
  `p ^ e ∈ Aff S ↔ G has a root mod p ^ e` for all primes `p ∤ R'` and all `e`.

In (c), (e) and parts of (f) `S` is an arbitrary set of polynomials (the paper's `Sys(E)` is a finite
set); where a Bézout-type sum is needed it is a `Finset`. `G` is any integer polynomial with `f = G * h f`
(the paper takes the primitive part of the `ℚ`-gcd, which is one such `G`).
Not covered: the parenthetical remark in (d) that a non-zero resultant of two polynomials of `S` lies in
the ideal; the existence of the common factor `G` and its cofactors in (f) (the ℚ-gcd and Gauss's lemma:
`G` and `h` are hypotheses). Throughout, a set of laws enters (c)–(f) only through its affine system, a
set of polynomials (linked to the laws by (b)).
-/

open Polynomial

namespace Infinity.C13

/-! ### (a) Affine anchored tables -/

/-- **CLM-C13-01 (a).** If an operation on `ZMod N` has the form `x ⋆ y = α x + β y + γ` and satisfies the
anchor `x ⋆ 0 = x + 1`, then `α = 1` and `γ = 1`; hence `x ⋆ y = x + β y + 1`. No hypothesis on `N` is
needed (for `N = 1` all three conclusions are trivial since `ZMod 1` has one element). -/
theorem affine_anchored {N : ℕ} (op : ZMod N → ZMod N → ZMod N) (α β γ : ZMod N)
    (hop : ∀ x y, op x y = α * x + β * y + γ) (anchor : ∀ x, op x 0 = x + 1) :
    α = 1 ∧ γ = 1 ∧ ∀ x y, op x y = x + β * y + 1 := by
  have h0 := anchor 0
  have h1 := anchor 1
  rw [hop] at h0 h1
  have hγ : γ = 1 := by linear_combination h0
  have hα : α = 1 := by linear_combination h1 - h0
  exact ⟨hα, hγ, fun x y => by rw [hop, hα, hγ]; ring⟩

/-- Converse of `affine_anchored`: every table `x ⋆ y = x + a y + 1` is anchored. -/
theorem affine_table_anchored {N : ℕ} (a : ZMod N) : ∀ x : ZMod N, x + a * 0 + 1 = x + 1 := by
  intro x; ring

/-! ### The common-root spectrum of a set of integer polynomials -/

/-- The common-root spectrum of a set `S` of integer polynomials: the sizes `N ≥ 1` modulo which all
polynomials of `S` have a common root. By `affModels_eq` (CLM-C13-01 (b)), `Aff (sysLaws E)` is the set of
sizes with an affine anchored model of the laws `E`. -/
def Aff (S : Set ℤ[X]) : Set ℕ :=
  {N | 1 ≤ N ∧ ∃ a : ZMod N, ∀ f ∈ S, aeval a f = 0}

/-- Evaluation of an integer polynomial commutes with every ring homomorphism. -/
theorem aeval_ringHom {A B : Type*} [CommRing A] [CommRing B] (g : A →+* B) (a : A) (f : ℤ[X]) :
    aeval (g a) f = g (aeval a f) :=
  aeval_algHom_apply g.toIntAlgHom a f

/-! ### (b) Affine evaluation of terms: `Aff(E)` is the common-root spectrum of `Sys(E)` -/

/-- Terms (binary trees) over a type `V` of variables. -/
inductive Term (V : Type) where
  | var : V → Term V
  | node : Term V → Term V → Term V

namespace Term

variable {V : Type}

/-- Value of a term in the magma `op` under the assignment `ρ`. -/
def eval {M : Type} (op : M → M → M) (ρ : V → M) : Term V → M
  | var v => ρ v
  | node s t => op (s.eval op ρ) (t.eval op ρ)

/-- The coefficient polynomial `C_t[v] ∈ ℤ[a]`: `C_v[v] = 1`, `C_u[v] = 0` (`u ≠ v`),
`C_{st}[v] = C_s[v] + a · C_t[v]`. -/
noncomputable def coeffP [DecidableEq V] (v : V) : Term V → ℤ[X]
  | var u => if u = v then 1 else 0
  | node s t => s.coeffP v + X * t.coeffP v

/-- The constant polynomial `D_t ∈ ℤ[a]`: `D_v = 0`, `D_{st} = D_s + a · D_t + 1`. -/
noncomputable def constP : Term V → ℤ[X]
  | var _ => 0
  | node s t => s.constP + X * t.constP + 1

/-- **Affine evaluation.** In the affine table `x ⋆ y = x + a·y + 1` on `ZMod N` every term is the linear
form `Σ_v C_t[v](a) · ρ(v) + D_t(a)`. -/
theorem eval_affine [Fintype V] [DecidableEq V] {N : ℕ} (a : ZMod N) (ρ : V → ZMod N) (t : Term V) :
    t.eval (fun x y => x + a * y + 1) ρ = ∑ v, aeval a (t.coeffP v) * ρ v + aeval a t.constP := by
  induction t with
  | var u => simp [eval, coeffP, constP]
  | node s t ihs iht =>
    simp only [eval, coeffP, constP, ihs, iht, map_add, map_mul, aeval_X, map_one, add_mul,
      Finset.sum_add_distrib]
    simp only [mul_add, Finset.mul_sum, mul_assoc]
    ring

end Term

/-- The affine system `Sys(s = t) = {C_s[v] - C_t[v] : v ∈ V} ∪ {D_s - D_t}` of a law `s = t`. -/
noncomputable def sysLaw {V : Type} [DecidableEq V] (s t : Term V) : Set ℤ[X] :=
  Set.range (fun v => s.coeffP v - t.coeffP v) ∪ {s.constP - t.constP}

/-- **A law holds in an affine table iff its affine system vanishes.** For every `a : ZMod N`, the law
`s = t` holds in `x ⋆ y = x + a·y + 1` (for all assignments of the variables) iff every polynomial of
`Sys(s = t)` vanishes at `a`. -/
theorem law_holds_affine_iff {V : Type} [Fintype V] [DecidableEq V] {N : ℕ} (s t : Term V)
    (a : ZMod N) :
    (∀ ρ : V → ZMod N, s.eval (fun x y => x + a * y + 1) ρ = t.eval (fun x y => x + a * y + 1) ρ) ↔
      ∀ f ∈ sysLaw s t, aeval a f = 0 := by
  simp only [Term.eval_affine]
  constructor
  · intro h f hf
    -- the zero assignment gives `D_s(a) = D_t(a)`
    have h0 := h 0
    simp only [Pi.zero_apply, mul_zero, Finset.sum_const_zero, zero_add] at h0
    rcases hf with ⟨v, rfl⟩ | hf
    · -- the assignment `v ↦ 1`, others `↦ 0`, gives `C_s[v](a) + D_s(a) = C_t[v](a) + D_t(a)`
      have hv := h (fun u => if u = v then 1 else 0)
      simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hv
      rw [map_sub, sub_eq_zero]
      linear_combination hv - h0
    · rw [Set.mem_singleton_iff] at hf
      rw [hf, map_sub, h0, sub_self]
  · intro h ρ
    have hD : aeval a s.constP = aeval a t.constP := by
      have := h _ (Set.mem_union_right _ (Set.mem_singleton _))
      rwa [map_sub, sub_eq_zero] at this
    have hC : ∀ v, aeval a (s.coeffP v) = aeval a (t.coeffP v) := by
      intro v
      have := h _ (Set.mem_union_left _ ⟨v, rfl⟩)
      simp only at this
      rwa [map_sub, sub_eq_zero] at this
    simp only [hC, hD]

/-- The affine system `Sys(E) = ⋃_{(s = t) ∈ E} Sys(s = t)` of a set of laws. -/
noncomputable def sysLaws {V : Type} [DecidableEq V] (E : Set (Term V × Term V)) : Set ℤ[X] :=
  ⋃ e ∈ E, sysLaw e.1 e.2

/-- The sizes `N ≥ 1` with an *affine anchored model* of the laws `E`: some table
`x ⋆ y = x + a·y + 1` on `ZMod N` satisfies every law of `E`. (By `affine_anchored`, these are all
anchored tables of the form `α x + β y + γ`.) -/
def affModels {V : Type} (E : Set (Term V × Term V)) : Set ℕ :=
  {N | 1 ≤ N ∧ ∃ a : ZMod N, ∀ e ∈ E, ∀ ρ : V → ZMod N,
    e.1.eval (fun x y => x + a * y + 1) ρ = e.2.eval (fun x y => x + a * y + 1) ρ}

/-- **CLM-C13-01 (b).** `Aff(E) = {N : the polynomials of Sys(E) have a common root modulo N}`. -/
theorem affModels_eq {V : Type} [Fintype V] [DecidableEq V] (E : Set (Term V × Term V)) :
    affModels E = Aff (sysLaws E) := by
  ext N
  simp only [affModels, Aff, sysLaws, Set.mem_iUnion]
  refine and_congr_right (fun _ => exists_congr (fun a => ?_))
  constructor
  · rintro h f ⟨e, ⟨he, hf⟩⟩
    exact (law_holds_affine_iff e.1 e.2 a).mp (h e he) f hf
  · intro h e he
    exact (law_holds_affine_iff e.1 e.2 a).mpr (fun f hf => h f ⟨e, he, hf⟩)

/-! ### (c) Closure under divisors and coprime products -/

/-- `1 ∈ Aff S` for every `S` (every element of `ZMod 1` is a root of everything). -/
theorem aff_one (S : Set ℤ[X]) : 1 ∈ Aff S :=
  ⟨le_rfl, 0, fun _ _ => Subsingleton.elim _ _⟩

/-- **CLM-C13-01 (c), divisors.** If `N ∈ Aff S` and `d ∣ N` then `d ∈ Aff S`: a common root modulo `N`
reduces to a common root modulo `d`. -/
theorem aff_of_dvd {S : Set ℤ[X]} {N d : ℕ} (hN : N ∈ Aff S) (hd : d ∣ N) : d ∈ Aff S := by
  obtain ⟨hN1, a, ha⟩ := hN
  refine ⟨Nat.pos_of_dvd_of_pos hd hN1, ZMod.castHom hd (ZMod d) a, fun f hf => ?_⟩
  rw [aeval_ringHom, ha f hf, map_zero]

/-- **CLM-C13-01 (c), coprime products.** If `N, M ∈ Aff S` and `gcd(N, M) = 1` then `N * M ∈ Aff S`
(Chinese remainder theorem). -/
theorem aff_mul_of_coprime {S : Set ℤ[X]} {N M : ℕ} (hN : N ∈ Aff S) (hM : M ∈ Aff S)
    (hco : Nat.Coprime N M) : N * M ∈ Aff S := by
  obtain ⟨hN1, a, ha⟩ := hN
  obtain ⟨hM1, b, hb⟩ := hM
  let e := ZMod.chineseRemainder hco
  refine ⟨Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega)), e.symm (a, b),
    fun f hf => ?_⟩
  apply e.injective
  rw [map_zero]
  have h1 : e (aeval (e.symm (a, b)) f) = aeval (e (e.symm (a, b))) f :=
    (aeval_ringHom e.toRingHom (e.symm (a, b)) f).symm
  rw [h1, RingEquiv.apply_symm_apply, aeval_prod_apply, ha f hf, hb f hf]
  rfl

/-- A product of powers of distinct primes, each power in `Aff S`, lies in `Aff S`. -/
theorem aff_prod_primePow {S : Set ℤ[X]} (k : ℕ → ℕ) :
    ∀ s : Finset ℕ, (∀ p ∈ s, p.Prime) → (∀ p ∈ s, p ^ k p ∈ Aff S) → (∏ p ∈ s, p ^ k p) ∈ Aff S := by
  intro s
  induction s using Finset.induction_on with
  | empty => intro _ _; simpa using aff_one S
  | insert q s hq ih =>
    intro hprime hmem
    rw [Finset.prod_insert hq]
    refine aff_mul_of_coprime (hmem q (Finset.mem_insert_self q s))
      (ih (fun p hp => hprime p (Finset.mem_insert_of_mem hp))
        (fun p hp => hmem p (Finset.mem_insert_of_mem hp))) ?_
    refine Nat.Coprime.prod_right (fun p hp => ?_)
    exact Nat.coprime_pow_primes _ _ (hprime q (Finset.mem_insert_self q s))
      (hprime p (Finset.mem_insert_of_mem hp)) (fun h => hq (h ▸ hp))

/-- **CLM-C13-01 (c), prime-power description.** For `N ≠ 0`: `N ∈ Aff S` iff `p ^ e ∈ Aff S` for every
prime power `p ^ e ‖ N` (`e = v_p(N) = N.factorization p`). -/
theorem mem_aff_iff_primePow {S : Set ℤ[X]} {N : ℕ} (hN : N ≠ 0) :
    N ∈ Aff S ↔ ∀ p ∈ N.primeFactors, p ^ N.factorization p ∈ Aff S := by
  constructor
  · intro h p _
    exact aff_of_dvd h (Nat.ordProj_dvd N p)
  · intro h
    rw [Nat.prod_primeFactors_pow_factorization hN]
    exact aff_prod_primePow _ _ (fun p hp => Nat.prime_of_mem_primeFactors hp) h

/-! ### (d), (e): the parts that need neither Bézout over `ℚ` nor Schur's theorem -/

/-- **CLM-C13-01 (e), last sentence.** `Aff ∅` consists of all `N ≥ 1`. -/
theorem aff_empty : Aff (∅ : Set ℤ[X]) = {N | 1 ≤ N} := by
  ext N
  exact ⟨fun h => h.1, fun h => ⟨h, 0, fun f hf => absurd hf (Set.notMem_empty f)⟩⟩

/-- `Aff S` is closed under `lcm` (from (c): the prime powers of `lcm(N, M)` divide `N` or `M`). -/
theorem aff_lcm {S : Set ℤ[X]} {N M : ℕ} (hN : N ∈ Aff S) (hM : M ∈ Aff S) : Nat.lcm N M ∈ Aff S := by
  have hN0 : N ≠ 0 := by have := hN.1; omega
  have hM0 : M ≠ 0 := by have := hM.1; omega
  rw [mem_aff_iff_primePow (Nat.lcm_ne_zero hN0 hM0)]
  intro p _
  rw [Nat.factorization_lcm hN0 hM0, Finsupp.sup_apply]
  rcases le_total (N.factorization p) (M.factorization p) with h | h
  · rw [sup_eq_right.mpr h]
    exact aff_of_dvd hM (Nat.ordProj_dvd M p)
  · rw [sup_eq_left.mpr h]
    exact aff_of_dvd hN (Nat.ordProj_dvd N p)

/-- **CLM-C13-01 (d), the bound.** If an integer `R` lies in the ideal generated by `S` in `ℤ[X]`
(`Σ_{f ∈ S} u f * f = C R`), then every `N ∈ Aff S` divides `R`. -/
theorem dvd_of_mem_aff (S : Finset ℤ[X]) (u : ℤ[X] → ℤ[X]) (R : ℤ) (hsum : ∑ f ∈ S, u f * f = C R)
    {N : ℕ} (hN : N ∈ Aff (S : Set ℤ[X])) : (N : ℤ) ∣ R := by
  obtain ⟨_, a, ha⟩ := hN
  have h : aeval a (C R) = 0 := by
    rw [← hsum, map_sum]
    exact Finset.sum_eq_zero (fun f hf => by rw [map_mul, ha f (Finset.mem_coe.mpr hf), mul_zero])
  rw [aeval_C, algebraMap_int_eq, eq_intCast] at h
  exact (ZMod.intCast_zmod_eq_zero_iff_dvd R N).mp h

/-- **CLM-C13-01 (d), finiteness.** If some non-zero integer `R` lies in the ideal generated by `S`, then
`Aff S` is finite (it is contained in the set of divisors of `R`). -/
theorem aff_finite (S : Finset ℤ[X]) (u : ℤ[X] → ℤ[X]) (R : ℤ) (hR : R ≠ 0)
    (hsum : ∑ f ∈ S, u f * f = C R) : (Aff (S : Set ℤ[X])).Finite := by
  refine (Set.finite_Iic R.natAbs).subset (fun N hN => ?_)
  have h := Int.natCast_dvd.mp (dvd_of_mem_aff S u R hsum hN)
  exact Nat.le_of_dvd (Int.natAbs_pos.mpr hR) h

/-- **CLM-C13-01 (d), structure.** A finite `Aff S` is the set of divisors of its maximum `L`. -/
theorem aff_eq_divisors {S : Set ℤ[X]} (hfin : (Aff S).Finite) :
    ∃ L ∈ Aff S, (∀ N ∈ Aff S, N ≤ L) ∧ ∀ N, N ∈ Aff S ↔ N ∣ L := by
  have hne : hfin.toFinset.Nonempty := ⟨1, hfin.mem_toFinset.mpr (aff_one S)⟩
  set L := hfin.toFinset.max' hne
  have hL : L ∈ Aff S := hfin.mem_toFinset.mp (Finset.max'_mem _ hne)
  have hmax : ∀ N ∈ Aff S, N ≤ L := fun N hN => Finset.le_max' _ N (hfin.mem_toFinset.mpr hN)
  have hL1 : 1 ≤ L := hL.1
  refine ⟨L, hL, hmax, fun N => ⟨fun hN => ?_, fun hd => aff_of_dvd hL hd⟩⟩
  have hN1 : 1 ≤ N := hN.1
  have hlcm := aff_lcm hN hL
  have h1 : Nat.lcm N L ≤ L := hmax _ hlcm
  have h2 : L ≤ Nat.lcm N L := Nat.le_of_dvd (Nat.lcm_pos (by omega) (by omega)) (Nat.dvd_lcm_right N L)
  have heq : Nat.lcm N L = L := le_antisymm h1 h2
  rw [← heq]
  exact Nat.dvd_lcm_left N L

/-- **CLM-C13-01 (d), the maximum divides `R`.** If a non-zero integer `R` lies in the ideal generated by
`S`, then `Aff S` is the set of divisors of its maximum `L`, and `L ∣ R`. -/
theorem aff_eq_divisors_of_ideal (S : Finset ℤ[X]) (u : ℤ[X] → ℤ[X]) (R : ℤ) (hR : R ≠ 0)
    (hsum : ∑ f ∈ S, u f * f = C R) :
    ∃ L ∈ Aff (S : Set ℤ[X]), (∀ N, N ∈ Aff (S : Set ℤ[X]) ↔ N ∣ L) ∧ (L : ℤ) ∣ R := by
  obtain ⟨L, hL, -, hdiv⟩ := aff_eq_divisors (aff_finite S u R hR hsum)
  exact ⟨L, hL, hdiv, dvd_of_mem_aff S u R hsum hL⟩

/-- **CLM-C13-01 (d), the Bézout step.** If the polynomials of a finite set `S ⊆ ℤ[X]` have no common
factor of positive degree in `ℚ[X]`, some non-zero integer `R` lies in the ideal they generate in `ℤ[X]`:
`Σ_{f ∈ S} u f * f = C R`. (The hypothesis forces `S ≠ ∅`: otherwise `X` would be a common factor.) -/
theorem exists_int_mem_ideal (S : Finset ℤ[X])
    (hS : ∀ g : ℚ[X], (∀ f ∈ S, g ∣ f.map (Int.castRingHom ℚ)) → g.degree ≤ 0) :
    ∃ (R : ℤ) (u : ℤ[X] → ℤ[X]), R ≠ 0 ∧ ∑ f ∈ S, u f * f = C R := by
  classical
  set φ : ℤ[X] →+* ℚ[X] := Polynomial.mapRingHom (Int.castRingHom ℚ) with hφdef
  have hφ : Function.Injective φ := Polynomial.map_injective _ (RingHom.injective_int _)
  let v : S → ℚ[X] := fun i => φ i.val
  set I : Ideal ℚ[X] := Ideal.span (Set.range v)
  set g := Submodule.IsPrincipal.generator I
  have hgI : ∀ f ∈ S, g ∣ f.map (Int.castRingHom ℚ) := by
    intro f hf
    exact (Submodule.IsPrincipal.mem_iff_generator_dvd I).mp (Ideal.subset_span ⟨⟨f, hf⟩, rfl⟩)
  have hdeg := hS g hgI
  have hg0 : g ≠ 0 := by
    intro hg
    have hall : ∀ f ∈ S, f.map (Int.castRingHom ℚ) = 0 := by
      intro f hf
      have := hgI f hf
      rw [hg] at this
      exact zero_dvd_iff.mp this
    have := hS X (fun f hf => by rw [hall f hf]; exact dvd_zero X)
    rw [Polynomial.degree_X] at this
    exact absurd this (by decide)
  have hunit : IsUnit g := by
    have hC := Polynomial.eq_C_of_degree_le_zero hdeg
    rw [hC] at hg0 ⊢
    exact Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr (fun h => hg0 (by rw [h, map_zero])))
  have htop : I = ⊤ := by
    rw [← Submodule.IsPrincipal.span_singleton_generator I]
    exact Ideal.span_singleton_eq_top.mpr hunit
  have h1 : (1 : ℚ[X]) ∈ I := by rw [htop]; trivial
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.mp h1
  -- clear the denominators of the coefficients `c i`
  have hnorm : ∀ i : S, ∃ b : ℤ, b ≠ 0 ∧ ∃ p : ℤ[X], φ p = C (b : ℚ) * c i := by
    intro i
    obtain ⟨b, hb, hp⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ℤ) (c i)
    refine ⟨b, nonZeroDivisors.ne_zero hb, IsLocalization.integerNormalization (nonZeroDivisors ℤ) (c i),
      ?_⟩
    rw [hφdef, Polynomial.coe_mapRingHom, ← algebraMap_int_eq, hp, ← Int.cast_smul_eq_zsmul ℚ,
      Polynomial.smul_eq_C_mul]
  choose b hb p hp using hnorm
  set D : ℤ := ∏ i, b i
  let u' : S → ℤ[X] := fun i => C (∏ j ∈ Finset.univ.erase i, b j) * p i
  refine ⟨D, fun f => if h : f ∈ S then u' ⟨f, h⟩ else 0, Finset.prod_ne_zero_iff.mpr (fun i _ => hb i),
    ?_⟩
  have hsum : ∑ f ∈ S, (if h : f ∈ S then u' ⟨f, h⟩ else 0) * f = ∑ i : S, u' i * i.val := by
    rw [← Finset.sum_coe_sort S]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    simp only [i.2, ↓reduceDIte]
  rw [hsum]
  apply hφ
  rw [map_sum]
  have hterm : ∀ i : S, φ (u' i * i.val) = C (D : ℚ) * (c i * v i) := by
    intro i
    simp only [u', map_mul, hp i, v]
    simp only [hφdef, Polynomial.coe_mapRingHom, Polynomial.map_C, Int.coe_castRingHom]
    have hD : ((∏ j ∈ Finset.univ.erase i, b j : ℤ) : ℚ) * (b i : ℚ) = (D : ℚ) := by
      rw [← Int.cast_mul, Finset.prod_erase_mul _ _ (Finset.mem_univ i)]
    rw [← hD, Polynomial.C_mul]
    ring
  rw [Finset.sum_congr rfl (fun i _ => hterm i), ← Finset.mul_sum, hc, mul_one, hφdef,
    Polynomial.coe_mapRingHom, Polynomial.map_C]
  rfl

/-- **CLM-C13-01 (d).** If the polynomials of a finite set `S ⊆ ℤ[X]` have no common factor of positive
degree in `ℚ[X]`, then `Aff S` is finite, it is the set of divisors of its maximum `L`, and `L` divides
every integer `R` of the ideal generated by `S` in `ℤ[X]`. -/
theorem aff_structure_of_no_common_factor (S : Finset ℤ[X])
    (hS : ∀ g : ℚ[X], (∀ f ∈ S, g ∣ f.map (Int.castRingHom ℚ)) → g.degree ≤ 0) :
    (Aff (S : Set ℤ[X])).Finite ∧ ∃ L ∈ Aff (S : Set ℤ[X]), (∀ N ∈ Aff (S : Set ℤ[X]), N ≤ L) ∧
      (∀ N, N ∈ Aff (S : Set ℤ[X]) ↔ N ∣ L) ∧
      ∀ (R : ℤ) (u : ℤ[X] → ℤ[X]), ∑ f ∈ S, u f * f = C R → (L : ℤ) ∣ R := by
  obtain ⟨R, u, hR, hsum⟩ := exists_int_mem_ideal S hS
  have hfin := aff_finite S u R hR hsum
  obtain ⟨L, hL, hmax, hdiv⟩ := aff_eq_divisors hfin
  exact ⟨hfin, L, hL, hmax, hdiv, fun R' u' hsum' => dvd_of_mem_aff S u' R' hsum' hL⟩

/-! ### (f) Prime powers not dividing the cofactor resultant -/

/-- **CLM-C13-01 (f), first sentence.** If `G` divides every `f ∈ S` in `ℤ[X]`, then every `N ≥ 1` modulo
which `G` has a root belongs to `Aff S`. -/
theorem aff_of_root {S : Set ℤ[X]} {G : ℤ[X]} (hG : ∀ f ∈ S, G ∣ f) {N : ℕ} (hN : 1 ≤ N)
    (a : ZMod N) (ha : aeval a G = 0) : N ∈ Aff S := by
  refine ⟨hN, a, fun f hf => ?_⟩
  obtain ⟨g, rfl⟩ := hG f hf
  rw [map_mul, ha, zero_mul]

/-- **CLM-C13-01 (f), general form.** Let `f = G * h f` for every `f ∈ S`, and let `R'` be an integer in the
ideal generated by the cofactors `h f` (`C R' ∈ Ideal.span (h '' S)`). If `p` is a prime with `p ∤ R'`,
then for every `e` the polynomials of `S` have a common root modulo `p ^ e` iff `G` has a root modulo
`p ^ e`. (`G` need not be the primitive part of the `ℚ`-gcd; `R' ≠ 0` follows from `p ∤ R'`; `e = 0` is
allowed, both sides being trivially true.) -/
theorem primePow_root_iff_of_mem_span (S : Set ℤ[X]) (G : ℤ[X]) (h : ℤ[X] → ℤ[X])
    (hfac : ∀ f ∈ S, f = G * h f) (R' : ℤ) (hR' : C R' ∈ Ideal.span (h '' S))
    {p : ℕ} (hp : p.Prime) (hpR : ¬ (p : ℤ) ∣ R') (e : ℕ) :
    (∃ a : ZMod (p ^ e), ∀ f ∈ S, aeval a f = 0) ↔ ∃ a : ZMod (p ^ e), aeval a G = 0 := by
  constructor
  · rintro ⟨a, ha⟩
    refine ⟨a, ?_⟩
    rcases Nat.eq_zero_or_pos e with rfl | he
    · have : Subsingleton (ZMod (p ^ 0)) := by rw [pow_zero]; infer_instance
      exact Subsingleton.elim _ _
    have : NeZero (p ^ e) := ⟨pow_ne_zero e hp.ne_zero⟩
    -- reduce modulo `p`: `ψ = (mod p) ∘ (evaluation at a)`
    let π : ZMod (p ^ e) →+* ZMod p := ZMod.castHom (dvd_pow_self p he.ne') (ZMod p)
    let ψ : ℤ[X] →+* ZMod p := π.comp (aeval a : ℤ[X] →ₐ[ℤ] ZMod (p ^ e)).toRingHom
    -- some cofactor `h f` does not vanish at `a` modulo `p`
    have hex : ∃ f ∈ S, ψ (h f) ≠ 0 := by
      by_contra hcon'
      have hcon : ∀ f ∈ S, ψ (h f) = 0 :=
        fun f hf => by_contra (fun hne => hcon' ⟨f, hf, hne⟩)
      have hle : Ideal.span (h '' S) ≤ RingHom.ker ψ := by
        rw [Ideal.span_le]
        rintro _ ⟨f, hf, rfl⟩
        exact (RingHom.mem_ker).mpr (hcon f hf)
      have hR : ψ (C R') = 0 := (RingHom.mem_ker).mp (hle hR')
      simp only [ψ, AlgHom.toRingHom_eq_coe, eq_intCast, map_intCast] at hR
      exact hpR ((ZMod.intCast_zmod_eq_zero_iff_dvd R' p).mp hR)
    obtain ⟨f, hf, hne⟩ := hex
    -- so `h f (a)` is a unit modulo `p ^ e`
    have hunit : IsUnit (aeval a (h f)) := by
      set x := aeval a (h f)
      have hx : ψ (h f) = ((x.val : ℕ) : ZMod p) := by
        simp only [ψ, π, x, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
          ZMod.castHom_apply, ZMod.cast_eq_val]
      rw [hx, Ne, ZMod.natCast_eq_zero_iff] at hne
      have hcop : Nat.Coprime x.val (p ^ e) :=
        Nat.Coprime.pow_right e (Nat.coprime_comm.mp ((Nat.Prime.coprime_iff_not_dvd hp).mpr hne))
      rw [← ZMod.natCast_zmod_val x]
      exact (ZMod.isUnit_iff_coprime x.val (p ^ e)).mpr hcop
    have h0 := ha f hf
    rw [hfac f hf, map_mul] at h0
    exact (hunit.mul_left_eq_zero).mp h0
  · rintro ⟨a, ha⟩
    refine ⟨a, fun f hf => ?_⟩
    rw [hfac f hf, map_mul, ha, zero_mul]

/-- A Bézout-type sum `Σ_{f ∈ S} u f * h f = C R'` puts `C R'` in the ideal generated by the cofactors. -/
theorem C_mem_span_of_sum (S : Finset ℤ[X]) (h u : ℤ[X] → ℤ[X]) (R' : ℤ)
    (hsum : ∑ f ∈ S, u f * h f = C R') : C R' ∈ Ideal.span (h '' (S : Set ℤ[X])) := by
  rw [← hsum]
  exact Ideal.sum_mem _ (fun f hf => Ideal.mul_mem_left _ _
    (Ideal.subset_span ⟨f, Finset.mem_coe.mpr hf, rfl⟩))

/-- **CLM-C13-01 (f)**, in the form with explicit Bézout coefficients: if `f = G * h f` for every `f ∈ S`,
`Σ_{f ∈ S} u f * h f = C R'` and `p` is a prime with `p ∤ R'`, then for every `e`
`(∃ a : ZMod (p ^ e), ∀ f ∈ S, f(a) = 0) ↔ ∃ a : ZMod (p ^ e), G(a) = 0`. -/
theorem primePow_root_iff (S : Finset ℤ[X]) (G : ℤ[X]) (h u : ℤ[X] → ℤ[X])
    (hfac : ∀ f ∈ S, f = G * h f) (R' : ℤ) (hsum : ∑ f ∈ S, u f * h f = C R')
    {p : ℕ} (hp : p.Prime) (hpR : ¬ (p : ℤ) ∣ R') (e : ℕ) :
    (∃ a : ZMod (p ^ e), ∀ f ∈ S, aeval a f = 0) ↔ ∃ a : ZMod (p ^ e), aeval a G = 0 := by
  have := primePow_root_iff_of_mem_span (S : Set ℤ[X]) G h (fun f hf => hfac f (Finset.mem_coe.mp hf))
    R' (C_mem_span_of_sum S h u R' hsum) hp hpR e
  simpa only [Finset.mem_coe] using this

/-- **CLM-C13-01 (f), in terms of `Aff`.** Under the hypotheses of `primePow_root_iff`,
`p ^ e ∈ Aff S ↔ G has a root modulo p ^ e`, for every `e`. -/
theorem primePow_mem_aff_iff (S : Finset ℤ[X]) (G : ℤ[X]) (h u : ℤ[X] → ℤ[X])
    (hfac : ∀ f ∈ S, f = G * h f) (R' : ℤ) (hsum : ∑ f ∈ S, u f * h f = C R')
    {p : ℕ} (hp : p.Prime) (hpR : ¬ (p : ℤ) ∣ R') (e : ℕ) :
    p ^ e ∈ Aff (S : Set ℤ[X]) ↔ ∃ a : ZMod (p ^ e), aeval a G = 0 := by
  rw [← primePow_root_iff S G h u hfac R' hsum hp hpR e]
  constructor
  · rintro ⟨-, a, ha⟩
    exact ⟨a, fun f hf => ha f (Finset.mem_coe.mpr hf)⟩
  · rintro ⟨a, ha⟩
    exact ⟨Nat.one_le_iff_ne_zero.mpr (pow_ne_zero e hp.ne_zero), a,
      fun f hf => ha f (Finset.mem_coe.mp hf)⟩

/-- **CLM-C13-01 (f), complete.** Let `S` be finite with `f = G * h f` for every `f ∈ S`, and suppose the
cofactors `h f` have no common factor of positive degree in `ℚ[X]`. Then there is an integer `R' ≠ 0` in the
ideal generated by the cofactors such that for every prime `p ∤ R'` and every `e`:
`p ^ e ∈ Aff S ↔ G has a root modulo p ^ e`. -/
theorem primePow_mem_aff_iff_of_coprime_cofactors (S : Finset ℤ[X]) (G : ℤ[X]) (h : ℤ[X] → ℤ[X])
    (hfac : ∀ f ∈ S, f = G * h f)
    (hcof : ∀ g : ℚ[X], (∀ f ∈ S, g ∣ (h f).map (Int.castRingHom ℚ)) → g.degree ≤ 0) :
    ∃ R' : ℤ, R' ≠ 0 ∧ C R' ∈ Ideal.span (h '' (S : Set ℤ[X])) ∧
      ∀ p : ℕ, p.Prime → ¬ (p : ℤ) ∣ R' → ∀ e : ℕ,
        (p ^ e ∈ Aff (S : Set ℤ[X]) ↔ ∃ a : ZMod (p ^ e), aeval a G = 0) := by
  classical
  obtain ⟨R', u, hR'0, hsum⟩ := exists_int_mem_ideal (S.image h)
    (fun g hg => hcof g (fun f hf => hg (h f) (Finset.mem_image_of_mem h hf)))
  have hmem : C R' ∈ Ideal.span (h '' (S : Set ℤ[X])) := by
    rw [← hsum]
    refine Ideal.sum_mem _ (fun t ht => Ideal.mul_mem_left _ _ (Ideal.subset_span ?_))
    obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp ht
    exact ⟨f, Finset.mem_coe.mpr hf, rfl⟩
  refine ⟨R', hR'0, hmem, fun p hp hpR e => ?_⟩
  rw [← primePow_root_iff_of_mem_span (S : Set ℤ[X]) G h
    (fun f hf => hfac f (Finset.mem_coe.mp hf)) R' hmem hp hpR e]
  exact ⟨fun hA => hA.2, fun hA => ⟨Nat.one_le_iff_ne_zero.mpr (pow_ne_zero e hp.ne_zero), hA⟩⟩

/-! ### (e) Infinitude when there is a common factor -/

/-- **CLM-C13-01 (e), over `ℤ`.** If an integer polynomial `G` of positive degree divides every `f ∈ S`
in `ℤ[X]`, then `Aff S` is infinite. -/
theorem aff_infinite_of_dvd {S : Set ℤ[X]} {G : ℤ[X]} (hG : 0 < G.degree) (hdvd : ∀ f ∈ S, G ∣ f) :
    (Aff S).Infinite := by
  intro hfin
  obtain ⟨B, hB⟩ := hfin.bddAbove
  have hP : 0 < (G.map (Int.castRingHom ℝ)).degree := by
    rw [Polynomial.degree_map_eq_of_injective (RingHom.injective_int (Int.castRingHom ℝ))]
    exact hG
  obtain ⟨x₀, hx₀⟩ := Filter.tendsto_atTop_atTop.mp (Polynomial.abs_tendsto_atTop _ hP) ((B : ℝ) + 1)
  obtain ⟨k, hk⟩ := exists_nat_ge x₀
  have h1 := hx₀ (k : ℝ) hk
  set z := G.eval (k : ℤ) with hz
  have hev : (G.map (Int.castRingHom ℝ)).eval (k : ℝ) = (z : ℝ) := by
    simp [hz]
  rw [hev] at h1
  have hN : ((z.natAbs : ℕ) : ℝ) = |(z : ℝ)| := by rw [Nat.cast_natAbs, Int.cast_abs]
  have hB0 : (0 : ℝ) ≤ B := Nat.cast_nonneg B
  have hN1 : 1 ≤ z.natAbs := by
    have : (1 : ℝ) ≤ (z.natAbs : ℝ) := by rw [hN]; linarith
    exact_mod_cast this
  have hmem : z.natAbs ∈ Aff S := by
    refine aff_of_root hdvd hN1 ((k : ℤ) : ZMod z.natAbs) ?_
    have e := aeval_ringHom (Int.castRingHom (ZMod z.natAbs)) (k : ℤ) G
    rw [Polynomial.coe_aeval_eq_eval, Int.coe_castRingHom] at e
    rw [e, ← hz]
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd z z.natAbs).mpr (Int.natAbs_dvd.mpr dvd_rfl)
  have hle : (z.natAbs : ℝ) ≤ B := by exact_mod_cast hB hmem
  linarith

/-- **CLM-C13-01 (e).** If the polynomials of `S` have a common factor `G ∈ ℚ[X]` of positive degree,
`Aff S` is infinite. (Gauss's lemma turns `G` into a primitive integer polynomial dividing every `f`
in `ℤ[X]`; then `aff_infinite_of_dvd`.) -/
theorem aff_infinite {S : Set ℤ[X]} {G : ℚ[X]} (hG : 0 < G.degree)
    (hdvd : ∀ f ∈ S, G ∣ f.map (Int.castRingHom ℚ)) : (Aff S).Infinite := by
  obtain ⟨b, hb, hbG⟩ := IsLocalization.integerNormalization_spec (nonZeroDivisors ℤ) G
  set G₀ := IsLocalization.integerNormalization (nonZeroDivisors ℤ) G
  have hb0 : (b : ℚ) ≠ 0 := by exact_mod_cast nonZeroDivisors.ne_zero hb
  have hbG' : G₀.map (Int.castRingHom ℚ) = C (b : ℚ) * G := by
    rw [← algebraMap_int_eq, hbG, ← Int.cast_smul_eq_zsmul ℚ, Polynomial.smul_eq_C_mul]
  have hG0 : G ≠ 0 := by rintro rfl; simp at hG
  have hG₀0 : G₀ ≠ 0 := by
    intro h
    rw [h, Polynomial.map_zero] at hbG'
    exact hG0 ((mul_eq_zero.mp hbG'.symm).resolve_left (Polynomial.C_ne_zero.mpr hb0))
  set G' := G₀.primPart
  have hc0 : (G₀.content : ℚ) ≠ 0 := by
    exact_mod_cast fun h => hG₀0 (Polynomial.content_eq_zero_iff.mp h)
  -- `G = C (content / b) * map G'`
  have hGeq : G = C ((G₀.content : ℚ) / b) * G'.map (Int.castRingHom ℚ) := by
    have e := congrArg (Polynomial.map (Int.castRingHom ℚ)) G₀.eq_C_content_mul_primPart
    rw [Polynomial.map_mul, Polynomial.map_C, hbG'] at e
    have e2 : G = C (1 / (b : ℚ)) * (C (b : ℚ) * G) := by
      rw [← mul_assoc, ← Polynomial.C_mul, one_div_mul_cancel hb0, Polynomial.C_1, one_mul]
    rw [e2, e, ← mul_assoc, ← Polynomial.C_mul]
    congr 2
    simp only [eq_intCast]
    field_simp
  have hdvd' : ∀ f ∈ S, G' ∣ f := by
    intro f hf
    refine (Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast G' f
      (Polynomial.isPrimitive_primPart G₀)).mpr ?_
    exact dvd_trans (Dvd.intro_left _ hGeq.symm) (hdvd f hf)
  have hdeg : 0 < G'.degree := by
    have : G.degree = G'.degree := by
      rw [hGeq, Polynomial.degree_C_mul (div_ne_zero hc0 hb0),
        Polynomial.degree_map_eq_of_injective (RingHom.injective_int (Int.castRingHom ℚ))]
    rw [← this]; exact hG
  exact aff_infinite_of_dvd hdeg hdvd'

