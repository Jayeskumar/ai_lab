import Mathlib.Logic.Relation
import Mathlib.Data.List.Count
import Mathlib.Tactic

/-!
# Cycle C01 — Quantity as the complete invariant of rewriting

Formal companions to the claims of cycle C01 (see `research/cycles/C01_quantity/`).

* `commEq_iff_count`  (CLM-C01-01): two words are equal modulo the swap relations
  `xaby = xbay` iff every symbol occurs equally often; the projection of a word onto a
  symbol is the unary numeral `a…a`.
* `gen_iff`, `exactly_m_add_p_classes` (CLM-C01-02, single relation): the congruence on
  one-symbol words generated by `a^m = a^(m+p)` has the normal form `nf` and exactly
  `m + p` classes (index `m`, period `p`): counting modulo `p` above a threshold.
* `common_border_joinable` (lemma for CLM-C01-06): an overlap of the left-hand side `u`
  with itself along a border that is also a border of `v` gives a critical pair of
  `u → v` that is joinable in one step on each side.
-/

namespace Infinity.C01

open Relation

section Commutation

variable {α : Type*}

/-- One commutation step: swap two adjacent symbols anywhere in a word. -/
inductive CommStep : List α → List α → Prop
  | swap (x y : List α) (a b : α) : CommStep (x ++ a :: b :: y) (x ++ b :: a :: y)

/-- The congruence generated by commutation (equivalence closure of the swap steps). -/
def CommEq (u v : List α) : Prop := EqvGen CommStep u v

theorem commStep_perm {u v : List α} (h : CommStep u v) : u.Perm v := by
  cases h with
  | swap x y a b => exact List.Perm.append_left x (List.Perm.swap b a y)

theorem commEq_perm {u v : List α} (h : CommEq u v) : u.Perm v := by
  induction h with
  | rel _ _ h => exact commStep_perm h
  | refl _ => exact List.Perm.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih1 ih2 => exact ih1.trans ih2

theorem commEq_cons (c : α) {u v : List α} (h : CommEq u v) : CommEq (c :: u) (c :: v) := by
  induction h with
  | rel _ _ h =>
    cases h with
    | swap x y a b => exact EqvGen.rel _ _ (CommStep.swap (c :: x) y a b)
  | refl _ => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ ih1 ih2 => exact EqvGen.trans _ _ _ ih1 ih2

theorem perm_commEq {u v : List α} (h : u.Perm v) : CommEq u v := by
  induction h with
  | nil => exact EqvGen.refl _
  | cons c _ ih => exact commEq_cons c ih
  | swap a b l => exact EqvGen.rel _ _ (CommStep.swap [] l b a)
  | trans _ _ ih1 ih2 => exact EqvGen.trans _ _ _ ih1 ih2

/-- The commutation congruence is exactly "being a rearrangement". -/
theorem commEq_iff_perm {u v : List α} : CommEq u v ↔ u.Perm v :=
  ⟨commEq_perm, perm_commEq⟩

/-- **CLM-C01-01.** Symbol counts form a complete invariant of the commutation congruence. -/
theorem commEq_iff_count [DecidableEq α] {u v : List α} :
    CommEq u v ↔ ∀ a, u.count a = v.count a := by
  rw [commEq_iff_perm, List.perm_iff_count]

/-- The projection of a word onto one symbol is a unary numeral. -/
theorem projection_is_unary [DecidableEq α] (u : List α) (a : α) :
    u.filter (fun x => x == a) = List.replicate (u.count a) a := by
  induction u with
  | nil => simp
  | cons x u ih =>
    by_cases h : x = a
    · subst h
      simp [ih, List.replicate_succ]
    · have hb : (x == a) = false := by simpa using h
      simp [hb, ih, h]

end Commutation

section OneSymbol

/-- The congruence on one-symbol words (identified with their lengths) generated by
`a^m = a^(m+p)`; `shift` is closure under multiplication by `a^k`. -/
inductive Gen (m p : ℕ) : ℕ → ℕ → Prop
  | base : Gen m p m (m + p)
  | refl (x : ℕ) : Gen m p x x
  | symm {x y : ℕ} : Gen m p x y → Gen m p y x
  | trans {x y z : ℕ} : Gen m p x y → Gen m p y z → Gen m p x z
  | shift {x y : ℕ} (k : ℕ) : Gen m p x y → Gen m p (x + k) (y + k)

/-- Normal form: exponents below the index `m` are kept, the others are reduced into the
cycle `m, …, m + p - 1`. -/
def nf (m p x : ℕ) : ℕ := if x < m then x else m + (x - m) % p

theorem nf_shift (m p x k : ℕ) : nf m p (x + k) = nf m p (nf m p x + k) := by
  by_cases h : x < m
  · simp [nf, h]
  · have h1 : ¬ (x + k < m) := by omega
    have h2 : ¬ (m + (x - m) % p + k < m) := by omega
    have e1 : x + k - m = (x - m) + k := by omega
    have e2 : m + (x - m) % p + k - m = (x - m) % p + k := by omega
    simp only [nf, h, h1, h2, ite_false, e1, e2]
    rw [Nat.add_mod (x - m) k p, Nat.add_mod ((x - m) % p) k p, Nat.mod_mod]

theorem gen_nf {m p x y : ℕ} (h : Gen m p x y) : nf m p x = nf m p y := by
  induction h with
  | base => simp [nf]
  | refl _ => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2
  | shift k _ ih => rw [nf_shift _ _ _ k, ih, ← nf_shift]

theorem gen_self_nf (m p : ℕ) (hp : 0 < p) (x : ℕ) : Gen m p x (nf m p x) := by
  induction x using Nat.strong_induction_on with
  | _ x ih =>
    by_cases h : x < m
    · simp only [nf, h, ite_true]; exact Gen.refl x
    · by_cases h' : x < m + p
      · have : nf m p x = x := by
          simp only [nf, h, ite_false]
          rw [Nat.mod_eq_of_lt (by omega)]; omega
        rw [this]; exact Gen.refl x
      · -- a^(x-p) ~ a^x by the base relation shifted by x - m - p
        have step : Gen m p (x - p) x := by
          have := Gen.shift (m := m) (p := p) (x - m - p) Gen.base
          have e1 : m + (x - m - p) = x - p := by omega
          have e2 : m + p + (x - m - p) = x := by omega
          rwa [e1, e2] at this
        have hlt : x - p < x := by omega
        have same : nf m p (x - p) = nf m p x := by
          have a1 : ¬ (x - p < m) := by omega
          simp only [nf, a1, h, ite_false]
          have : x - m = (x - p - m) + p := by omega
          rw [this, Nat.add_mod_right]
        have := ih (x - p) hlt
        rw [same] at this
        exact Gen.trans (Gen.symm step) this

/-- **CLM-C01-02 (single relation).** `a^x = a^y` follows from `a^m = a^(m+p)` iff the
normal forms agree. -/
theorem gen_iff (m p : ℕ) (hp : 0 < p) (x y : ℕ) : Gen m p x y ↔ nf m p x = nf m p y := by
  constructor
  · exact gen_nf
  · intro h
    have hx := gen_self_nf m p hp x
    have hy := gen_self_nf m p hp y
    rw [h] at hx
    exact Gen.trans hx (Gen.symm hy)

theorem nf_lt (m p : ℕ) (hp : 0 < p) (x : ℕ) : nf m p x < m + p := by
  unfold nf
  split_ifs with h
  · omega
  · have := Nat.mod_lt (x - m) hp; omega

theorem nf_of_lt (m p x : ℕ) (hx : x < m + p) : nf m p x = x := by
  unfold nf
  split_ifs with h
  · rfl
  · rw [Nat.mod_eq_of_lt (by omega)]; omega

/-- **CLM-C01-02 (counting).** There are exactly `m + p` classes: every word is equivalent to
one of `a^0, …, a^(m+p-1)`, and these are pairwise inequivalent. -/
theorem exactly_m_add_p_classes (m p : ℕ) (hp : 0 < p) :
    (∀ x, ∃ y < m + p, Gen m p x y) ∧
    (∀ y z, y < m + p → z < m + p → Gen m p y z → y = z) := by
  refine ⟨fun x => ⟨nf m p x, nf_lt m p hp x, gen_self_nf m p hp x⟩, ?_⟩
  intro y z hy hz hyz
  have := gen_nf hyz
  rwa [nf_of_lt m p y hy, nf_of_lt m p z hz] at this

end OneSymbol

section Borders

variable {α : Type*}

/-- **Key lemma for CLM-C01-06.** Let `u = p ++ b = b ++ s` (so `b` is a border of `u`) and
`v = p' ++ b = b ++ s'` (`b` is also a border of `v`). The overlap word `p ++ b ++ s` has the
two one-step reducts `v ++ s` (rewrite the left occurrence of `u`) and `p ++ v` (rewrite the
right occurrence). Each contains a fresh occurrence of `u` whose rewriting yields the same
word `p' ++ v = v ++ s'`. -/
theorem common_border_joinable (u v b p s p' s' : List α)
    (hu1 : u = p ++ b) (hu2 : u = b ++ s) (hv1 : v = p' ++ b) (hv2 : v = b ++ s') :
    v ++ s = p' ++ u ∧ p ++ v = u ++ s' ∧ p' ++ v = v ++ s' := by
  refine ⟨?_, ?_, ?_⟩
  · rw [hv1, hu2, List.append_assoc]
  · rw [hv2, hu1, List.append_assoc]
  · calc p' ++ v = p' ++ (b ++ s') := by rw [hv2]
      _ = (p' ++ b) ++ s' := by rw [List.append_assoc]
      _ = v ++ s' := by rw [hv1]

end Borders

end Infinity.C01

